    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "pg": "^8.20.0",
    "playwright-core": "^1.61.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "unpdf": "^1.6.2",
    "uuid": "^14.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
