{
  "name": "wolfpack-apex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run migrate && next build",
    "migrate": "node scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint",
    "handoff": "node scripts/handoff-scaffold.mjs",
    "verify": "bash scripts/verify.sh",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --config=playwright.config.ts",
    "test:e2e:prod": "PROD_URL=${PROD_URL:-https://wolfpack-instinct.vercel.app} playwright test tests/e2e/ --config=playwright.config.ts",
    "test:e2e:reality": "playwright test tests/e2e/sites-preview-reality-check.spec.ts tests/e2e/sites-upload-reality-check.spec.ts tests/e2e/sites-designer-journey.spec.ts --config=playwright.config.ts",
    "canary": "PROD_URL=${PROD_URL:-https://wolfpack-instinct.vercel.app} playwright test tests/e2e/ --config=playwright.config.ts --reporter=github"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@react-pdf/renderer": "^4.5.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.7.16",
    "mailparser": "^3.9.8",
    "mammoth": "^1.12.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "unpdf": "^1.4.0",
    "uuid": "^13.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "protobufjs": "^7.5.4",
    "@xmldom/xmldom": "^0.9.10",
    "onnxruntime-web": "^1.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
