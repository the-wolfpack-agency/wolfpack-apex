{
  "name": "wolfpack-apex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run migrate && next build",
    "migrate": "node scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint",
    "handoff": "node scripts/handoff-scaffold.mjs",
    "proof:agents": "node scripts/agent-workforce-proof.mjs",
    "scan:tenant-isolation": "npx tsx scripts/scan-tenant-isolation.ts",
    "verify": "bash scripts/verify.sh",
    "verify:prod-env": "bash scripts/verify-prod-env.sh",
    "verify:devices": "npx tsx scripts/verify-devices.ts",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --config=playwright.config.ts",
    "test:e2e:prod": "PROD_URL=${PROD_URL:-https://wolfpack-instinct.vercel.app} playwright test tests/e2e/ --config=playwright.config.ts",
    "test:e2e:reality": "playwright test tests/e2e/sites-preview-reality-check.spec.ts tests/e2e/sites-upload-reality-check.spec.ts tests/e2e/sites-designer-journey.spec.ts --config=playwright.config.ts",
    "test:qr-download": "playwright test --config=playwright.qr.config.ts",
    "canary": "PROD_URL=${PROD_URL:-https://wolfpack-instinct.vercel.app} playwright test tests/e2e/ --config=playwright.config.ts --reporter=github",
    "self-scan": "npx tsx scripts/self-scan-ai-surfaces.ts",
    "release:notes": "npx tsx scripts/generate-release-notes.ts",
    "release:backfill": "npx tsx scripts/backfill-release-notes.ts",
    "engineering:seed": "npx tsx scripts/seed-engineering-wiki.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "branch:check": "npx tsx scripts/check-branch-base.ts",
    "test:spec-diff": "playwright test --config=playwright.specdiff.config.ts",
    "router:exercise": "npx tsx scripts/router-exercise.ts"
  },
  "dependencies": {
